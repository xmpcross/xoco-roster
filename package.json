{
  "name": "roster-astro-theme",
  "description": "An Astro theme for recruitment and executive search firms: a filterable jobs board, job pages with applications, a vacancy flow, consultant profiles, a salary guide with a calculator, case studies and insights.",
  "type": "module",
  "version": "1.0.1",
  "author": "Andrei Alba",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "keywords": [
    "astro-theme",
    "astro",
    "recruitment",
    "recruitment-agency",
    "executive-search",
    "jobs",
    "job-board",
    "careers",
    "staffing",
    "salary-guide",
    "consultancy",
    "tailwindcss"
  ],
  "homepage": "https://roster.xocoweb.workers.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/xocothemes/roster.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "release:check": "npm run check && npm run build && npm run format:check",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "yaml": "^2.8.3"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
