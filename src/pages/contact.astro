---
import Icon from "@/components/ui/Icon.astro";
import PageHero from "@/components/ui/PageHero.astro";
import { contact } from "@/config/contact";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

const { booking, forms, offices } = siteConfig;
const form = forms.contact;
---

<BaseLayout title="Contact" description={contact.lead}>
  <PageHero crumbs={[{ label: "Home", href: "/" }, { label: "Contact" }]} title={contact.title} lead={contact.lead} />

  <section id="book" class="pb-14 lg:pb-20" aria-labelledby="book-title">
    <div class="shell grid gap-6 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4 lg:pt-4">
        <h2 id="book-title" class="text-display-md">{booking.title}</h2>
        <p class="mt-4 text-muted">{booking.lead}</p>
        <ul class="mt-8 grid gap-3 text-[0.9375rem]">
          {
            ["A partner from your sector", "Market view and likely cost", "No obligation, no pitch deck"].map((item) => (
              <li class="flex items-center gap-3">
                <span class="grid size-6 shrink-0 place-items-center rounded-full bg-accent-soft text-accent">
                  <Icon name="check" class="size-3.5" stroke={2.5} />
                </span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-8">
        {
          booking.embedUrl ? (
            <iframe src={booking.embedUrl} title={booking.title} loading="lazy" class="card h-[44rem] w-full border-0" />
          ) : (
            <div class="card p-2" data-scheduler data-from={contact.slots.from} data-to={contact.slots.to} data-step={contact.slots.stepMinutes} data-days={contact.slots.days}>
              <noscript>
                <p class="p-5 text-muted">Suggest a time in the form below and we will confirm it by email.</p>
              </noscript>
              <div class="scheduler" hidden data-scheduler-ui>
                <div class="flex flex-wrap items-center justify-between gap-4 px-3 pt-2 pb-4 sm:px-4">
                  <p class="font-medium" data-month />
                  <div class="flex rounded-full bg-paper p-1" role="radiogroup" aria-label="Office">
                    {offices.map((office, i) => (
                      <label class="office-pill cursor-pointer rounded-full px-3.5 py-1.5 text-[0.8125rem] font-medium text-muted">
                        <input type="radio" name="slot-office" value={office.city} class="sr-only" checked={i === 0} />
                        {office.city}
                      </label>
                    ))}
                  </div>
                </div>
                <div class="grid gap-2 md:grid-cols-[1fr_1.4fr]">
                  <fieldset class="rounded-xl bg-paper p-4">
                    <legend class="float-left mb-3 text-[0.8125rem] text-muted">Day</legend>
                    <div class="clear-both grid grid-cols-4 gap-1.5" data-days-list />
                  </fieldset>
                  <fieldset class="rounded-xl bg-paper p-4">
                    <legend class="float-left mb-3 text-[0.8125rem] text-muted">
                      Time <span data-zone-label />
                    </legend>
                    <div class="clear-both grid grid-cols-3 gap-1.5 sm:grid-cols-4" data-times-list />
                  </fieldset>
                </div>
                <div class="flex flex-wrap items-center justify-between gap-4 px-3 pt-4 pb-2 sm:px-4">
                  <p class="text-[0.9375rem]" aria-live="polite" data-choice>
                    Pick a day and a time.
                  </p>
                  <button type="button" class="btn btn-accent" disabled data-request>
                    Request this time <Icon name="arrow-down" class="size-4" stroke={2} />
                  </button>
                </div>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="section pt-0 lg:pt-0" aria-labelledby="form-title">
    <div class="shell grid gap-6 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-8">
        <form id="contact-form" class="card p-6 sm:p-9" action={form.action || undefined} method={form.method} data-form data-demo={form.action ? undefined : ""}>
          <h2 id="form-title" class="text-display-md">Send a message</h2>
          <div class="mt-8 grid gap-6" data-form-body>
            <div>
              <label for="contact-topic" class="field-label">I'm writing about</label>
              <select id="contact-topic" name="topic" class="field" data-contact-topic>
                {contact.topics.map((topic) => <option value={topic.value}>{topic.label}</option>)}
              </select>
            </div>
            <div class="grid gap-6 sm:grid-cols-2">
              <div>
                <label for="contact-name" class="field-label">Name</label>
                <input id="contact-name" name="name" type="text" autocomplete="name" required class="field" />
              </div>
              <div>
                <label for="contact-email" class="field-label">Email</label>
                <input id="contact-email" name="email" type="email" autocomplete="email" required class="field" />
              </div>
              <div>
                <label for="contact-phone" class="field-label">Phone (optional)</label>
                <input id="contact-phone" name="phone" type="tel" autocomplete="tel" class="field" />
              </div>
              <div>
                <label for="contact-company" class="field-label">Company (optional)</label>
                <input id="contact-company" name="company" type="text" autocomplete="organization" class="field" />
              </div>
            </div>
            <div>
              <label for="contact-time" class="field-label">Preferred call time (optional)</label>
              <input id="contact-time" name="preferred_time" type="text" placeholder="e.g. Tuesday afternoon, London time" class="field" data-contact-time />
            </div>
            <div>
              <label for="contact-message" class="field-label">Message</label>
              <textarea id="contact-message" name="message" rows="5" required class="field"></textarea>
            </div>
            <label class="flex items-start gap-3 text-sm text-muted">
              <input type="checkbox" name="consent" required class="check mt-0.5" />
              <span>I agree to Roster using these details to reply to me, as described in the <a href="/privacy/" class="link text-ink">privacy notice</a>.</span>
            </label>
            <button type="submit" class="btn btn-primary justify-self-start">Send message <Icon name="arrow-right" class="btn-arrow" stroke={2} /></button>
          </div>
          <div class="mt-8 grid gap-3" role="status" data-form-success hidden>
            <span class="grid size-12 place-items-center rounded-xl bg-accent-soft text-accent">
              <Icon name="circle-check" class="size-6" stroke={1.75} />
            </span>
            <p class="mt-2 text-title">Thank you. We will reply within one working day.</p>
            <p class="text-muted">A copy of your message is on its way to your inbox.</p>
            <button type="button" class="btn btn-outline btn-sm mt-3 justify-self-start" data-form-reset>Send another</button>
          </div>
        </form>
      </div>

      <aside class="grid content-start gap-4 lg:col-span-4">
        <div class="card p-5 sm:p-6">
          <h3 class="font-medium">Direct lines</h3>
          <dl class="mt-4 grid gap-2">
            {
              contact.routes.map((route) => (
                <div class="rounded-xl bg-paper p-4">
                  <dt class="text-[0.9375rem] font-medium">{route.label}</dt>
                  <dd class="mt-0.5 text-sm text-muted">{route.detail}</dd>
                  <dd class="mt-1.5 text-[0.9375rem]">
                    <a href={`mailto:${route.email}`} class="link">{route.email}</a>
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
        {
          offices.map((office) => (
            <address class="card p-5 not-italic sm:p-6">
              <p class="flex items-center justify-between gap-4">
                <span class="text-title">{office.city}</span>
                <time class="pill tone-neutral tabular" data-clock={office.timeZone} />
              </p>
              <p class="mt-3 text-[0.9375rem] text-muted">
                {office.address.map((line) => (
                  <span class="block">{line}</span>
                ))}
              </p>
              <p class="mt-4 grid gap-1.5 text-[0.9375rem]">
                <a href={`tel:${office.phone.replace(/\s/g, "")}`} class="flex items-center gap-2.5 hover:text-accent">
                  <Icon name="phone" class="size-4 text-muted" />
                  {office.phone}
                </a>
                <a href={`mailto:${office.email}`} class="flex items-center gap-2.5 hover:text-accent">
                  <Icon name="mail" class="size-4 text-muted" />
                  {office.email}
                </a>
              </p>
            </address>
          ))
        }
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .office-pill {
    transition:
      background-color 0.15s,
      color 0.15s;
  }

  .office-pill:hover {
    color: var(--ink);
  }

  .office-pill:has(input:checked) {
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow-card);
  }

  .office-pill:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  :global([data-days-list] button),
  :global([data-times-list] button) {
    display: grid;
    place-items: center;
    min-height: 2.75rem;
    padding: 0.4rem;
    border-radius: 0.625rem;
    background: var(--surface);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    box-shadow: 0 0 0 1px var(--line);
    transition:
      background-color 0.15s,
      color 0.15s,
      box-shadow 0.15s;
  }

  :global([data-days-list] button) {
    min-height: 4rem;
    line-height: 1.2;
  }

  :global([data-days-list] button:hover:not(:disabled)),
  :global([data-times-list] button:hover:not(:disabled)) {
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 25%, var(--line));
  }

  :global([data-days-list] button[aria-pressed="true"]),
  :global([data-times-list] button[aria-pressed="true"]) {
    background: var(--accent);
    color: #fff;
    box-shadow: 0 1px 2px rgb(26 35 201 / 0.3);
  }

  :global([data-times-list] button:disabled) {
    background: transparent;
    color: color-mix(in srgb, var(--muted) 55%, transparent);
    box-shadow: none;
    text-decoration: line-through;
    cursor: not-allowed;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-scheduler]");
  const ui = root?.querySelector<HTMLElement>("[data-scheduler-ui]");
  const topic = document.querySelector<HTMLSelectElement>("[data-contact-topic]");
  const timeField = document.querySelector<HTMLInputElement>("[data-contact-time]");

  const param = new URLSearchParams(window.location.search).get("topic");
  if (topic && param && [...topic.options].some((option) => option.value === param)) topic.value = param;

  if (root && ui) {
    ui.hidden = false;
    const from = Number(root.dataset.from);
    const to = Number(root.dataset.to);
    const step = Number(root.dataset.step);
    const count = Number(root.dataset.days);
    const daysList = ui.querySelector<HTMLElement>("[data-days-list]")!;
    const timesList = ui.querySelector<HTMLElement>("[data-times-list]")!;
    const month = ui.querySelector<HTMLElement>("[data-month]")!;
    const choice = ui.querySelector<HTMLElement>("[data-choice]")!;
    const zoneLabel = ui.querySelector<HTMLElement>("[data-zone-label]")!;
    const request = ui.querySelector<HTMLButtonElement>("[data-request]")!;
    const offices = [...ui.querySelectorAll<HTMLInputElement>("input[name=slot-office]")];

    const days: Date[] = [];
    const cursor = new Date();
    cursor.setDate(cursor.getDate() + 1);
    while (days.length < count) {
      if (cursor.getDay() !== 0 && cursor.getDay() !== 6) days.push(new Date(cursor));
      cursor.setDate(cursor.getDate() + 1);
    }

    let day: Date | null = null;
    let time = "";
    const office = () => offices.find((input) => input.checked) ?? offices[0];
    const dayName = (date: Date) => date.toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long" });
    /* Some slots read as taken so the picker looks like a real diary; the pattern is stable per day. */
    const taken = (date: Date, index: number) => (date.getDate() * 7 + index * 3) % 5 === 0;

    const update = () => {
      request.disabled = !day || !time;
      choice.textContent = day && time ? `${dayName(day)} at ${time}, ${office().value} time` : day ? "Now pick a time." : "Pick a day and a time.";
    };

    const renderTimes = () => {
      timesList.replaceChildren();
      zoneLabel.textContent = `(${office().value})`;
      if (!day) return;
      let index = 0;
      for (let minutes = from * 60; minutes < to * 60; minutes += step) {
        const label = `${String(Math.floor(minutes / 60)).padStart(2, "0")}:${String(minutes % 60).padStart(2, "0")}`;
        const button = document.createElement("button");
        button.type = "button";
        button.textContent = label;
        button.disabled = taken(day, index++);
        button.setAttribute("aria-pressed", String(label === time));
        button.addEventListener("click", () => {
          time = label;
          timesList.querySelectorAll("button").forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
          update();
        });
        timesList.append(button);
      }
    };

    days.forEach((date, i) => {
      const button = document.createElement("button");
      button.type = "button";
      button.innerHTML = `<span class="label">${date.toLocaleDateString("en-GB", { weekday: "short" })}</span><span class="text-lg font-medium">${date.getDate()}</span>`;
      button.setAttribute("aria-label", dayName(date));
      button.setAttribute("aria-pressed", "false");
      button.addEventListener("click", () => {
        day = date;
        time = "";
        daysList.querySelectorAll("button").forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
        renderTimes();
        update();
      });
      daysList.append(button);
      if (i === 0) {
        month.textContent = date.toLocaleDateString("en-GB", { month: "long", year: "numeric" });
        day = date;
        button.setAttribute("aria-pressed", "true");
      }
    });
    renderTimes();
    update();

    offices.forEach((input) =>
      input.addEventListener("change", () => {
        time = "";
        renderTimes();
        update();
      }),
    );

    request.addEventListener("click", () => {
      if (!day || !time) return;
      if (timeField) timeField.value = `${dayName(day)}, ${time} (${office().value} time)`;
      if (topic) topic.value = "consultation";
      document.getElementById("contact-form")?.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
      document.getElementById("contact-name")?.focus({ preventScroll: true });
    });
  }
</script>
