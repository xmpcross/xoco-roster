---
import PostCard from "@/components/insights/PostCard.astro";
import JobRow from "@/components/jobs/JobRow.astro";
import Closing from "@/components/ui/Closing.astro";
import Faq from "@/components/ui/Faq.astro";
import Icon from "@/components/ui/Icon.astro";
import PageHero from "@/components/ui/PageHero.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import { candidates } from "@/config/candidates";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getJobs, getSectors } from "@/lib/content";
import { getPosts } from "@/lib/posts";

const [jobs, sectors, posts] = await Promise.all([getJobs(), getSectors(), getPosts()]);
const advice = posts.filter((post) => post.data.topic === "Careers" || post.data.topic === "Salaries").slice(0, 3);
const shortName = (id: string) => sectors.find((sector) => sector.id === id)?.data.short;
const { candidate, jobs: search } = siteConfig.actions;
---

<BaseLayout title="For candidates" description={candidates.lead}>
  <PageHero crumbs={[{ label: "Home", href: "/" }, { label: "Candidates" }]} title={candidates.title} lead={candidates.lead}>
    <div slot="aside" class="mt-6 flex flex-wrap gap-3">
      <a href={candidate.href} class="btn btn-accent">{candidate.label} <Icon name="arrow-right" class="btn-arrow" stroke={2} /></a>
      <a href={search.href} class="btn btn-outline">{search.label}</a>
    </div>
  </PageHero>

  <section class="pb-20 lg:pb-28" aria-label="Our promises">
    <div class="shell">
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          candidates.promises.map((item, i) => (
            <li class="reveal card flex flex-col p-6 lg:min-h-72" style={`--i:${i}`}>
              <span class="grid size-12 place-items-center rounded-xl bg-accent-soft text-accent">
                <Icon name={item.icon} class="size-5" stroke={1.75} />
              </span>
              <h2 class="mt-auto pt-10 text-xl tracking-[-0.02em]">{item.title}</h2>
              <p class="mt-2 text-[0.9375rem] text-muted">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section pt-0" aria-labelledby="steps-title">
    <div class="shell grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 id="steps-title" class="text-display-lg">Four steps, at your pace.</h2>
        <a href={candidate.href} class="btn btn-primary mt-8">{candidate.label} <Icon name="arrow-right" class="btn-arrow" stroke={2} /></a>
      </div>
      <div class="card p-6 sm:p-9 lg:col-span-8">
        <ol class="grid">
          {
            candidates.steps.map((step, i) => (
              <li class="reveal relative grid grid-cols-[1.75rem_minmax(0,1fr)] gap-x-5 pb-9 last:pb-0">
                {i < candidates.steps.length - 1 && <span class="absolute top-8 bottom-1 left-3.25 w-px bg-accent-bright" aria-hidden="true" />}
                <span class="relative grid size-7 place-items-center rounded-full bg-accent-soft" aria-hidden="true">
                  <span class="size-2.5 rounded-full bg-accent" />
                </span>
                <div>
                  <h3 class="text-title">{step.title}</h3>
                  <p class="mt-1.5 text-muted">{step.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section pt-0" aria-labelledby="roles-title">
    <div class="shell">
      <SectionHead title="Newest on the board" id="roles-title">
        <a href="/jobs/" class="btn btn-primary">All {jobs.length} roles <Icon name="arrow-right" class="btn-arrow" stroke={2} /></a>
      </SectionHead>
      <div class="mt-10 grid gap-3">
        {jobs.slice(0, 5).map((job) => <JobRow job={job} sector={shortName(job.data.sector.id)} />)}
      </div>
    </div>
  </section>

  <section class="section pt-0" aria-labelledby="pay-title">
    <div class="shell">
      <div class="grid items-center gap-10 rounded-card bg-accent-soft p-6 sm:p-10 lg:grid-cols-12 lg:p-14">
        <div class="lg:col-span-6">
          <h2 id="pay-title" class="text-display-lg">Where does your pay sit?</h2>
          <p class="mt-4 max-w-lg text-lead text-ink-soft">Compare your base with the bands for 26 senior roles across London, Manchester, New York and Boston, before anyone asks for your expectations.</p>
          <a href="/salary-guide/#calculator" class="btn btn-accent mt-8"><Icon name="calculator" class="size-4" stroke={2} /> Open the calculator</a>
        </div>
        <div class="lg:col-span-5 lg:col-start-8" aria-hidden="true">
          <div class="rounded-card bg-surface p-6 shadow-float">
            <p class="text-[0.8125rem] text-muted">Head of Data and AI · London</p>
            <p class="mt-3 text-display-lg tabular">61st</p>
            <p class="text-sm text-muted">percentile for a £190k base</p>
            <div class="relative mt-8 h-3 rounded-full bg-wash">
              <span class="absolute inset-y-0 left-[22%] w-[48%] rounded-full bg-accent"></span>
              <span class="absolute -top-1.5 h-6 w-0.75 -translate-x-1/2 rounded-full bg-ink" style="left:52%"></span>
            </div>
            <p class="mt-3 flex justify-between text-[0.8125rem] text-muted tabular"><span>£150k</span><span>£175k</span><span>£210k</span></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    advice.length > 0 && (
      <section class="section pt-0" aria-labelledby="advice-title">
        <div class="shell">
          <SectionHead title="Before your next conversation" id="advice-title">
            <a href="/insights/topic/careers/" class="btn btn-outline">
              Career advice <Icon name="arrow-right" class="btn-arrow" stroke={2} />
            </a>
          </SectionHead>
          <div class="mt-12 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
            {advice.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <Faq title="Questions candidates ask" items={candidates.faq} />
  <Closing />
</BaseLayout>
