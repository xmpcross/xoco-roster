---
import Icon from "@/components/ui/Icon.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate, getPosts, postHref, searchItems } from "@/lib/posts";

const posts = await getPosts();
const items = await searchItems(posts);
---

<BaseLayout title="Search insights" description="Search every Roster insight." noindex>
  <section class="shell pt-12 pb-24 lg:pt-20 lg:pb-32">
    <h1 class="text-display-lg">Search insights</h1>
    <form class="search-box card mt-10 flex max-w-2xl items-center gap-3 rounded-2xl px-5" role="search" action="/insights/search/" data-search-page>
      <Icon name="search" class="size-4 text-muted" />
      <label for="search-page-input" class="sr-only">Search insights</label>
      <input
        id="search-page-input"
        name="q"
        type="search"
        autocomplete="off"
        placeholder="Search insights, topics, authors"
        class="h-16 min-w-0 flex-1 bg-transparent text-lg outline-none placeholder:text-muted"
      />
    </form>
    <p class="mt-8 text-[0.9375rem] text-muted" aria-live="polite" data-search-summary>{posts.length} articles</p>
    <ol class="mt-4 grid max-w-3xl gap-2.5" data-search-list>
      {
        posts.map((post, i) => (
          <li data-href={postHref(post)}>
            <a href={postHref(post)} class="search-row card group flex items-center gap-4 px-5 py-4">
              <span class="min-w-0 flex-1">
                <span class="block text-lg leading-snug font-medium tracking-[-0.015em] transition-colors group-hover:text-accent">{post.data.title}</span>
                <span class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.8125rem] text-muted">
                  <span class="pill">{post.data.topic}</span>
                  <span>{formatDate(post.data.date)}</span>
                  <span aria-hidden="true">·</span>
                  <span>{items[i].author}</span>
                </span>
              </span>
              <span class="row-arrow hidden size-8 shrink-0 place-items-center rounded-full bg-paper sm:grid" aria-hidden="true">
                <Icon name="arrow-up-right" class="size-4" stroke={2} />
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<style>
  .search-box {
    transition: box-shadow 0.15s;
  }

  .search-box:focus-within {
    box-shadow:
      0 0 0 1px var(--accent),
      0 0 0 4px var(--accent-soft);
  }

  .search-row {
    transition:
      box-shadow 0.25s,
      transform 0.25s var(--ease-out-expo);
  }

  .search-row:hover {
    box-shadow: var(--shadow-float);
    transform: translateY(-2px);
  }

  .row-arrow {
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .search-row:hover .row-arrow {
    background: var(--ink);
    color: #fff;
  }
</style>

<script>
  import { rankPosts, type SearchItem } from "@/lib/search";

  const form = document.querySelector<HTMLFormElement>("[data-search-page]");
  const input = form?.querySelector("input");
  const list = document.querySelector<HTMLOListElement>("[data-search-list]");
  const summary = document.querySelector<HTMLElement>("[data-search-summary]");
  const rows = [...(list?.querySelectorAll<HTMLLIElement>("li") ?? [])];
  let index: SearchItem[] | null = null;

  const run = async () => {
    if (!input || !list || !summary) return;
    const query = input.value.trim();
    const url = new URL(window.location.href);
    if (query) url.searchParams.set("q", query);
    else url.searchParams.delete("q");
    history.replaceState(null, "", url);

    if (!query) {
      rows.forEach((row) => (row.hidden = false));
      summary.textContent = `${rows.length} articles`;
      return;
    }
    index ??= await fetch("/search-index.json")
      .then((response) => response.json() as Promise<SearchItem[]>)
      .catch(() => []);
    const ranked = rankPosts(index, query).map((item) => item.href);
    rows.forEach((row) => (row.hidden = !ranked.includes(row.dataset.href ?? "")));
    ranked.forEach((href) => {
      const row = rows.find((item) => item.dataset.href === href);
      if (row) list.append(row);
    });
    summary.textContent = ranked.length
      ? `${ranked.length} result${ranked.length === 1 ? "" : "s"} for “${query}”`
      : `No articles match “${query}”.`;
  };

  if (input) {
    input.value = new URLSearchParams(window.location.search).get("q") ?? "";
    input.addEventListener("input", run);
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      void run();
    });
    if (input.value) void run();
  }
</script>
