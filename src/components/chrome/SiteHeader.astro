---
import { Image } from "astro:assets";
import Icon from "@/components/ui/Icon.astro";
import Wordmark from "@/components/ui/Wordmark.astro";
import { navigation, siteConfig, type MenuFeature } from "@/config/site";
import {
  formatSalary,
  getJobs,
  getPlacements,
  getSectors,
  getTeam,
  jobHref,
  placementHref,
  sectorHref,
  tally,
} from "@/lib/content";

const [jobs, sectors, placements, team] = await Promise.all([getJobs(), getSectors(), getPlacements(), getTeam()]);
const counts = tally(jobs.map((job) => job.data.sector.id));
const newest = jobs.slice(0, 3);
const placement = placements.find((item) => item.data.featured) ?? placements[0];
const { employer, candidate, book } = siteConfig.actions;
const path = Astro.url.pathname;
const cities = new Intl.ListFormat(siteConfig.language, { type: "conjunction" }).format(siteConfig.offices.map((office) => office.city));

const isCurrent = (href: string) => !href.includes("#") && href !== "/" && path.startsWith(href);
const menus = navigation.map((item, index) => ({ ...item, id: `menu-${index}` }));
const featureOf = (item: (typeof menus)[number]): MenuFeature | undefined =>
  "columns" in item ? item.feature : undefined;
---

<header class="site-header fixed inset-x-0 top-0 z-50" data-header>
  <div class="header-bar relative z-20">
    <div class="shell flex h-(--header-h) items-center gap-4 lg:grid lg:grid-cols-[1fr_auto_1fr]">
      <a href="/" class="flex shrink-0 justify-self-start" aria-label={`${siteConfig.name} home`} data-logo-menu-trigger>
        <Wordmark class="h-[1.55rem]" />
      </a>

      <nav class="hidden lg:block" aria-label="Main">
        <ul class="flex items-center gap-0.5">
          {
            menus.map((item) => (
              <li>
                {"columns" in item ? (
                  <button type="button" class="nav-trigger" aria-expanded="false" aria-controls={item.id} data-menu-trigger={item.id}>
                    {item.label}
                    <Icon name="chevron-down" class="nav-plus size-3.5" stroke={2} />
                  </button>
                ) : (
                  <a href={item.href} class="nav-trigger" aria-current={isCurrent(item.href) ? "page" : undefined}>
                    {item.label}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="ml-auto flex items-center gap-1 justify-self-end sm:gap-2">
        <a href={candidate.href} class="nav-trigger max-xl:hidden!">
          {candidate.label}
        </a>
        <a href={employer.href} class="btn btn-primary btn-sm hidden sm:inline-flex">
          {employer.label}
        </a>
        <button
          type="button"
          class="-mr-2 grid size-11 place-items-center lg:hidden"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label="Open menu"
          data-mobile-toggle
        >
          <span class="grid" data-icon-open><Icon name="menu" class="size-6" /></span>
          <span class="hidden" data-icon-close><Icon name="x" class="size-6" /></span>
        </button>
      </div>
    </div>
  </div>

  {
    menus.map(
      (item) =>
        "columns" in item && (
          <div id={item.id} class="mega absolute inset-x-0 top-full z-10 hidden lg:block" inert data-menu-panel>
            <div class="shell">
              <div class:list={["mega-grid grid gap-2 pt-1 pb-8", item.columns.length > 1 ? "grid-cols-[1fr_1fr_22rem]" : "grid-cols-[2fr_22rem]"]}>
                {item.columns.map((column, index) => (
                  <div class="mega-col py-4 pr-8" style={`--i:${index}`}>
                    {column.title && <p class="text-[0.8125rem] font-medium text-muted">{column.title}</p>}
                    {column.sectors ? (
                      <ul class="mt-2 -mx-2.5 grid gap-0.5">
                        {sectors.map((sector) => (
                          <li>
                            <a href={sectorHref(sector.id)} class="mega-sector group" data-menu-link>
                              <span class="flex-1 font-medium">{sector.data.title}</span>
                              <span class="text-[0.8125rem] text-muted tabular">{counts[sector.id] ?? 0} roles</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <ul class:list={["mt-2 -mx-2.5 grid gap-0.5", item.columns.length === 1 && "grid-cols-2 gap-x-2"]}>
                        {column.links?.map((link) => (
                          <li>
                            <a href={link.href} class="mega-link group" data-menu-link>
                              {link.icon && (
                                <span class="mega-icon">
                                  <Icon name={link.icon} class="size-[1.05rem]" stroke={1.75} />
                                </span>
                              )}
                              <span class="min-w-0">
                                <span class="block leading-snug font-medium">{link.label}</span>
                                {link.description && <span class="mt-0.5 block text-sm leading-snug text-muted">{link.description}</span>}
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                ))}

                <div class="mega-col pt-3" style={`--i:${item.columns.length}`}>
                  {featureOf(item) === "roles" && (
                    <div class="flex h-full flex-col rounded-[0.8rem] bg-paper p-5">
                      <p class="flex items-center gap-2 text-[0.8125rem] font-medium text-muted">
                        <span class="live-dot" aria-hidden="true" /> Newest roles
                      </p>
                      <ul class="mt-3 grid gap-1.5">
                        {newest.map((job) => (
                          <li>
                            <a href={jobHref(job)} class="block rounded-lg bg-surface px-3.5 py-3 shadow-[0_0_0_1px_var(--line)] transition-shadow hover:shadow-[0_0_0_1px_var(--accent)]" data-menu-link>
                              <span class="block leading-snug font-medium">{job.data.title}</span>
                              <span class="mt-1 flex justify-between gap-3 text-[0.8125rem] text-muted">
                                <span>{job.data.location}</span>
                                <span class="font-medium text-ink tabular">{formatSalary(job.data.salary)}</span>
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul>
                      <a href="/jobs/" class="mt-auto inline-flex items-center gap-2 pt-4 text-sm font-medium" data-menu-link>
                        All {jobs.length} live roles <Icon name="arrow-right" class="btn-arrow" stroke={2} />
                      </a>
                    </div>
                  )}
                  {featureOf(item) === "placement" && placement && (
                    <a href={placementHref(placement)} class="group flex h-full flex-col rounded-[0.8rem] bg-accent-soft p-5" data-menu-link>
                      <span class="text-[0.8125rem] font-medium text-accent">Recent placement</span>
                      <span class="mt-auto pt-8 text-5xl font-medium tracking-[-0.04em]">{placement.data.metrics[0].value}</span>
                      <span class="mt-1 text-sm text-muted">{placement.data.metrics[0].label}</span>
                      <span class="mt-4 block leading-snug font-medium">
                        {placement.data.role}, {placement.data.client}
                      </span>
                      <span class="mt-3 inline-flex items-center gap-2 text-sm font-medium text-accent">
                        Read the case study <Icon name="arrow-right" class="btn-arrow" stroke={2} />
                      </span>
                    </a>
                  )}
                  {featureOf(item) === "salary" && (
                    <a href="/salary-guide/#report" class="group flex h-full flex-col rounded-[0.8rem] bg-paper p-5" data-menu-link>
                      <span class="text-[0.8125rem] font-medium text-muted">Free download</span>
                      <span class="mt-3 text-2xl leading-tight font-medium tracking-[-0.025em]">{siteConfig.report.title}</span>
                      <span class="mt-2 text-sm text-muted">{siteConfig.report.summary}</span>
                      <span class="mt-auto flex items-end gap-1.5 pt-6" aria-hidden="true">
                        {[38, 54, 46, 70, 62, 84, 76, 100].map((h) => (
                          <span class="w-full rounded-t-[3px] bg-accent-bright/70 transition-colors group-hover:bg-accent" style={`height:${h * 0.6}px`} />
                        ))}
                      </span>
                      <span class="mt-5 inline-flex items-center gap-2 text-sm font-medium">
                        Get the guide <Icon name="arrow-right" class="btn-arrow" stroke={2} />
                      </span>
                    </a>
                  )}
                  {featureOf(item) === "team" && (
                    <a href="/team/" class="group flex h-full flex-col rounded-[0.8rem] bg-paper p-5" data-menu-link>
                      <span class="grid grid-cols-4 gap-1.5">
                        {team.slice(0, 8).map((person) => (
                          <Image src={person.data.photo} alt="" width={120} height={150} class="aspect-square w-full rounded-full object-cover object-top" loading="lazy" />
                        ))}
                      </span>
                      <span class="mt-5 leading-snug font-medium">{team.length} partners and principals across {cities}</span>
                      <span class="mt-auto inline-flex items-center gap-2 pt-4 text-sm font-medium">
                        Meet the consultants <Icon name="arrow-right" class="btn-arrow" stroke={2} />
                      </span>
                    </a>
                  )}
                </div>
              </div>
            </div>
          </div>
        ),
    )
  }

  <div id="mobile-nav" class="mobile-nav fixed inset-x-0 top-0 bottom-0 z-10 overflow-y-auto bg-paper lg:hidden" inert data-mobile-nav>
    <nav class="shell flex min-h-full flex-col pt-[calc(var(--header-h)+0.5rem)] pb-8" aria-label="Mobile">
      <ul class="grid gap-1">
        {
          menus.map((item) => (
            <li>
              {"columns" in item ? (
                <details class="mobile-group" name="mobile-menu">
                  <summary class="flex items-center justify-between py-3 text-2xl font-medium tracking-[-0.025em]">
                    {item.label}
                    <Icon name="chevron-down" class="mobile-plus size-5 text-muted" stroke={2} />
                  </summary>
                  <div class="card mb-3 grid gap-5 p-4">
                    {item.columns.map((column) => (
                      <div>
                        {column.title && <p class="text-[0.8125rem] font-medium text-muted">{column.title}</p>}
                        <ul class="mt-1 grid">
                          {column.sectors
                            ? sectors.map((sector) => (
                                <li>
                                  <a href={sectorHref(sector.id)} class="flex items-center justify-between py-2 text-[1.0625rem]" data-menu-link>
                                    {sector.data.title}
                                    <span class="text-sm text-muted">{counts[sector.id] ?? 0}</span>
                                  </a>
                                </li>
                              ))
                            : column.links?.map((link) => (
                                <li>
                                  <a href={link.href} class="flex items-center gap-3 py-2 text-[1.0625rem]" data-menu-link>
                                    {link.icon && <Icon name={link.icon} class="size-4.5 text-muted" />}
                                    {link.label}
                                  </a>
                                </li>
                              ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </details>
              ) : (
                <a href={item.href} class="block py-3 text-2xl font-medium tracking-[-0.025em]" data-menu-link>
                  {item.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
      <div class="mt-auto grid gap-3 pt-10">
        <a href={employer.href} class="btn btn-primary w-full">{employer.label}</a>
        <a href={candidate.href} class="btn btn-outline w-full">{candidate.label}</a>
        <a href={book.href} class="py-2 text-center font-medium text-muted">{book.label}</a>
      </div>
    </nav>
  </div>

  <div class="menu-scrim fixed inset-0 -z-10 bg-ink/15" data-menu-scrim></div>
</header>

<style>
  .site-header {
    transition: transform 0.45s var(--ease-out-expo);
  }

  .site-header[data-hidden] {
    transform: translateY(-110%);
  }

  .header-bar {
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    transition:
      background-color 0.2s,
      box-shadow 0.25s;
  }

  [data-scrolled] .header-bar {
    box-shadow: 0 1px 0 rgb(23 23 26 / 0.06);
  }

  /* An open menu and the bar read as one white panel. */
  [data-menu-open] .header-bar {
    background: var(--surface);
    box-shadow: none;
  }

  [data-mobile-open] .header-bar {
    background: var(--paper);
  }

  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 500;
    white-space: nowrap;
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .nav-trigger:hover,
  .nav-trigger[aria-expanded="true"] {
    background: rgb(23 23 26 / 0.05);
  }

  .nav-trigger[aria-current="page"] {
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--line);
  }

  .nav-plus {
    color: var(--muted);
    transition: transform 0.35s var(--ease-out-expo);
  }

  .nav-trigger[aria-expanded="true"] .nav-plus {
    transform: rotate(180deg);
    color: var(--ink);
  }

  /* Closed panels stay rendered (so they can fade) but are inert and click-through. */
  .mega {
    background: var(--surface);
    border-radius: 0 0 1.25rem 1.25rem;
    box-shadow: 0 30px 50px -24px rgb(23 23 26 / 0.22);
    opacity: 0;
    pointer-events: none;
    clip-path: inset(0 0 100% 0);
    transition:
      opacity 0.18s,
      clip-path 0.3s var(--ease-out-expo);
  }

  .mega[data-open] {
    opacity: 1;
    pointer-events: auto;
    clip-path: inset(0 0 -4rem 0);
    transition:
      opacity 0.15s,
      clip-path 0.4s var(--ease-out-expo);
  }

  .mega-col {
    opacity: 0;
    transform: translateY(-0.25rem);
    transition:
      opacity 0.25s,
      transform 0.4s var(--ease-out-expo);
  }

  .mega[data-open] .mega-col {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i) * 35ms + 30ms);
  }

  .mega-link {
    display: flex;
    gap: 0.85rem;
    padding: 0.65rem 0.6rem;
    border-radius: 0.7rem;
    transition: background-color 0.15s;
  }

  .mega-link:hover,
  .mega-link:focus-visible {
    background: var(--paper);
  }

  .mega-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.6rem;
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--line);
    transition:
      background-color 0.15s,
      color 0.15s,
      box-shadow 0.15s;
  }

  .mega-link:hover .mega-icon {
    background: var(--accent-soft);
    color: var(--accent);
    box-shadow: inset 0 0 0 1px transparent;
  }

  .mega-sector {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.65rem;
    border-radius: 0.6rem;
    transition:
      background-color 0.15s,
      color 0.15s;
  }

  .mega-sector:hover {
    background: var(--paper);
    color: var(--accent);
  }

  .menu-scrim {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.25s,
      visibility 0s 0.25s;
  }

  [data-menu-open] .menu-scrim {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.25s;
  }

  .mobile-nav {
    overscroll-behavior: contain;
    scrollbar-width: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s;
  }

  [data-mobile-open] .mobile-nav {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-nav::-webkit-scrollbar {
    display: none;
  }

  .mobile-group summary {
    list-style: none;
    cursor: pointer;
  }

  .mobile-group summary::-webkit-details-marker {
    display: none;
  }

  .mobile-plus {
    transition: transform 0.3s var(--ease-out-expo);
  }

  .mobile-group[open] .mobile-plus {
    transform: rotate(180deg);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");

  /* Office clocks: hours and minutes in each office's own zone, refreshed on the minute. */
  const clocks = [...document.querySelectorAll<HTMLTimeElement>("[data-clock]")];
  const tick = () =>
    clocks.forEach((clock) => {
      const zone = clock.dataset.clock;
      clock.textContent = new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", timeZone: zone }).format(new Date());
    });
  if (clocks.length) {
    tick();
    window.setTimeout(() => {
      tick();
      window.setInterval(tick, 60_000);
    }, (60 - new Date().getSeconds()) * 1000);
  }

  if (header) {
    const triggers = [...header.querySelectorAll<HTMLButtonElement>("[data-menu-trigger]")];
    const panels = [...header.querySelectorAll<HTMLElement>("[data-menu-panel]")];
    const scrim = header.querySelector<HTMLElement>("[data-menu-scrim]");
    const mobileToggle = header.querySelector<HTMLButtonElement>("[data-mobile-toggle]");
    const mobileNav = header.querySelector<HTMLElement>("[data-mobile-nav]");
    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
    let current: string | null = null;
    let hoverTimer = 0;

    const setMenu = (id: string | null, focusFirst = false) => {
      current = id;
      triggers.forEach((trigger) => trigger.setAttribute("aria-expanded", String(trigger.dataset.menuTrigger === id)));
      panels.forEach((panel) => {
        panel.toggleAttribute("data-open", panel.id === id);
        panel.inert = panel.id !== id;
      });
      header.toggleAttribute("data-menu-open", id !== null);
      if (id && focusFirst) {
        document.getElementById(id)?.querySelector<HTMLElement>("a")?.focus();
      }
    };

    const closeMenu = (returnFocus = false) => {
      const trigger = triggers.find((item) => item.dataset.menuTrigger === current);
      setMenu(null);
      if (returnFocus) trigger?.focus();
    };

    triggers.forEach((trigger) => {
      const id = trigger.dataset.menuTrigger ?? null;
      trigger.addEventListener("click", () => setMenu(current === id ? null : id));
      trigger.addEventListener("keydown", (event) => {
        if (event.key === "ArrowDown") {
          event.preventDefault();
          setMenu(id, true);
        }
      });
      trigger.addEventListener("pointerenter", () => {
        if (!finePointer.matches) return;
        window.clearTimeout(hoverTimer);
        hoverTimer = window.setTimeout(() => setMenu(id), current ? 0 : 90);
      });
    });

    /* Leaving the bar or the open panel starts a short timer; the menu closes
       only if the pointer is in neither when it runs. */
    const bar = header.querySelector<HTMLElement>(".header-bar");
    const hoverZones = [bar, ...panels].filter((el): el is HTMLElement => el !== null);
    let pointer = { x: 0, y: 0 };
    document.addEventListener("pointermove", (event) => (pointer = { x: event.clientX, y: event.clientY }), {
      passive: true,
    });
    const scheduleClose = () => {
      if (!finePointer.matches || !current) return;
      window.clearTimeout(hoverTimer);
      hoverTimer = window.setTimeout(() => {
        const inside = hoverZones.some((zone) => {
          if (zone !== bar && zone.id !== current) return false;
          const box = zone.getBoundingClientRect();
          return pointer.x >= box.left && pointer.x <= box.right && pointer.y >= box.top && pointer.y <= box.bottom;
        });
        if (!inside) closeMenu();
      }, 220);
    };
    hoverZones.forEach((zone) => {
      zone.addEventListener("pointerleave", scheduleClose);
      zone.addEventListener("pointerenter", () => {
        if (current) window.clearTimeout(hoverTimer);
      });
    });

    bar?.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
      link.addEventListener("pointerenter", () => {
        if (!finePointer.matches || !current) return;
        window.clearTimeout(hoverTimer);
        hoverTimer = window.setTimeout(() => closeMenu(), 90);
      });
      link.addEventListener("focus", () => {
        if (current) closeMenu();
      });
    });

    scrim?.addEventListener("click", () => closeMenu());

    header.addEventListener("focusout", (event) => {
      const next = event.relatedTarget as Node | null;
      if (current && next && !header.contains(next)) closeMenu();
    });

    const setMobile = (open: boolean) => {
      header.toggleAttribute("data-mobile-open", open);
      if (mobileNav) mobileNav.inert = !open;
      mobileToggle?.setAttribute("aria-expanded", String(open));
      mobileToggle?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      mobileToggle?.querySelector("[data-icon-open]")?.classList.toggle("hidden", open);
      mobileToggle?.querySelector("[data-icon-close]")?.classList.toggle("hidden", !open);
      document.documentElement.style.overflow = open ? "hidden" : "";
    };

    mobileToggle?.addEventListener("click", () => setMobile(!header.hasAttribute("data-mobile-open")));

    header.querySelectorAll("[data-menu-link]").forEach((link) =>
      link.addEventListener("click", () => {
        closeMenu();
        setMobile(false);
      }),
    );

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (current) closeMenu(true);
      if (header.hasAttribute("data-mobile-open")) {
        setMobile(false);
        mobileToggle?.focus();
      }
    });

    window.matchMedia("(min-width: 64rem)").addEventListener("change", (event) => {
      if (event.matches) setMobile(false);
      else closeMenu();
    });

    /* Hide while scrolling down, return on any scroll up. Never hides near the
       top, or while a menu or the mobile sheet is open. */
    let lastY = window.scrollY;
    const onScroll = () => {
      const y = window.scrollY;
      const busy = current !== null || header.hasAttribute("data-mobile-open") || header.contains(document.activeElement);
      header.toggleAttribute("data-scrolled", y > 4);
      if (y < 160 || busy) header.removeAttribute("data-hidden");
      else if (Math.abs(y - lastY) > 6) header.toggleAttribute("data-hidden", y > lastY);
      lastY = y;
      document.documentElement.toggleAttribute("data-header-hidden", header.hasAttribute("data-hidden"));
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    header.addEventListener("focusin", () => header.removeAttribute("data-hidden"));
  }
</script>
