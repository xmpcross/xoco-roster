---
import Icon from "@/components/ui/Icon.astro";
import Wordmark from "@/components/ui/Wordmark.astro";
import { footerNavigation, siteConfig } from "@/config/site";
import { socialIcon } from "@/lib/socials";

const { newsletter, forms } = siteConfig;
const form = forms.newsletter;
const year = new Date().getFullYear();
---

<footer class="bg-wash">
  <div class="shell">
    <div class="grid gap-14 pt-20 pb-16 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-5">
        <a href="/" class="inline-flex" aria-label={`${siteConfig.name} home`} data-logo-menu-trigger>
          <Wordmark class="h-[1.55rem]" />
        </a>
        <p class="mt-10 text-[0.875rem] text-muted">{newsletter.title}</p>
        <p class="mt-4 max-w-sm text-[0.9375rem]">{newsletter.description}</p>
        <form
          class="mt-6 max-w-md"
          action={form.action || undefined}
          method={form.method}
          data-form
          data-demo={form.action ? undefined : ""}
        >
          <div class="flex gap-2 rounded-card bg-surface p-1.5 shadow-card" data-form-body>
            <label for="footer-email" class="sr-only">Email address</label>
            <input
              id="footer-email"
              name={form.emailFieldName}
              type="email"
              required
              autocomplete="email"
              placeholder="you@company.com"
              class="h-11 min-w-0 flex-1 bg-transparent px-3 outline-none placeholder:text-muted"
            />
            <button type="submit" class="btn btn-primary h-11 min-h-0">Subscribe</button>
          </div>
          <p class="flex items-center gap-2" role="status" data-form-success hidden>
            <Icon name="circle-check" class="size-5 text-up" />
            You are on the list. The next issue lands on the first Tuesday of the month.
          </p>
        </form>
      </div>

      <nav class="grid grid-cols-2 gap-10 sm:grid-cols-4 lg:col-span-7" aria-label="Footer">
        {
          footerNavigation.map((column) => (
            <div>
              <p class="text-[0.875rem] text-muted">{column.title}</p>
              <ul class="mt-4 grid gap-2.5">
                {column.links.map((link) => (
                  <li>
                    <a href={link.href} class="text-[0.9375rem] font-medium transition-colors hover:text-accent">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="flex flex-col gap-5 py-6 text-sm text-muted md:flex-row md:items-center">
      <p>© {year} {siteConfig.name}. Est. {siteConfig.founded}.</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {
          siteConfig.legal.map((link) => (
            <li>
              <a href={link.href} class="hover:text-ink">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="flex items-center gap-1 md:ml-auto">
        {
          siteConfig.socials.map((social) => (
            <li>
              <a href={social.href} class="grid size-9 place-items-center rounded-full transition-colors hover:bg-surface hover:text-ink" aria-label={social.label}>
                <Icon name={socialIcon(social.label)} class="size-4" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
