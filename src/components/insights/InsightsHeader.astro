---
import TopicNav from "@/components/insights/TopicNav.astro";
import Icon from "@/components/ui/Icon.astro";

interface Props {
  title: string;
  description: string;
  topic?: string;
}

const { title, description, topic } = Astro.props;
---

<header class="pt-12 pb-10 sm:pt-16 lg:pb-12">
  <div class="shell">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-6">
      <div class="max-w-3xl">
        <h1 class="rise text-display-xl">{title}</h1>
        <p class="rise mt-5 max-w-2xl text-lead text-muted" style="--i:1">{description}</p>
      </div>
      <button
        type="button"
        class="rise field flex w-full max-w-xs items-center gap-3 text-left text-[0.9375rem] text-muted transition-colors hover:text-ink"
        style="--i:2"
        data-search-open
      >
        <Icon name="search" class="size-4" />
        <span class="flex-1">Search insights</span>
        <kbd class="rounded-md bg-paper px-1.5 py-0.5 font-sans text-xs font-medium text-muted">⌘K</kbd>
      </button>
    </div>
    <div class="rise mt-10" style="--i:3">
      <TopicNav current={topic} />
    </div>
  </div>
</header>
