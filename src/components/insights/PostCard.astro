---
import { Image } from "astro:assets";
import { formatDate, postAuthor, postHref, type Post } from "@/lib/posts";

interface Props {
  post: Post;
  variant?: "card" | "lead";
  headingLevel?: "h2" | "h3";
  eager?: boolean;
}

const { post, variant = "card", headingLevel = "h3", eager = false } = Astro.props;
const { title, description, cover, coverAlt, topic, date } = post.data;
const author = await postAuthor(post);
const Heading = headingLevel;
const lead = variant === "lead";
---

<article class:list={["post-card group relative flex h-full flex-col", lead && "gap-8 lg:grid lg:grid-cols-12 lg:items-center lg:gap-12"]}>
  <div class:list={["overflow-hidden rounded-card bg-wash", lead ? "aspect-16/10 lg:col-span-7" : "aspect-3/2"]}>
    <Image
      src={cover}
      alt={coverAlt}
      widths={lead ? [640, 960, 1400] : [480, 720, 960]}
      sizes={lead ? "(min-width: 1024px) 50rem, 100vw" : "(min-width: 1024px) 26rem, (min-width: 640px) 50vw, 100vw"}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager && lead ? "high" : undefined}
      class="photo-zoom size-full object-cover group-hover:scale-[1.03]"
    />
  </div>
  <div class:list={["flex flex-1 flex-col", lead ? "lg:col-span-5" : "mt-5"]}>
    <p class="flex flex-wrap items-center gap-x-2 text-[0.8125rem] text-muted">
      <span class="pill">{topic}</span>
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
    </p>
    <Heading class:list={["mt-3", lead ? "text-display-md" : "text-xl leading-snug tracking-[-0.02em]"]}>
      <a href={postHref(post)} class="post-link after:absolute after:inset-0">{title}</a>
    </Heading>
    <p class:list={["mt-2.5 text-muted", lead ? "text-lead" : "line-clamp-2 text-[0.9375rem]"]}>{description}</p>
    {author && <p class:list={["text-sm font-medium", lead ? "mt-6" : "mt-auto pt-4"]}>{author.data.name}</p>}
  </div>
</article>

<style>
  .post-link {
    transition: color 0.2s;
  }

  .post-card:hover .post-link {
    color: var(--accent);
  }

  .post-card:has(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
    border-radius: var(--radius-card);
  }

  .post-card a:focus-visible {
    outline: none;
  }
</style>
