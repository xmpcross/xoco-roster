---
interface Props {
  items: { value: string; unit?: string; label: string }[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<dl class:list={["grid grid-cols-2 gap-x-6 gap-y-10 sm:gap-x-8", items.length >= 4 ? "lg:grid-cols-4" : "lg:grid-cols-3", className]}>
  {
    items.map((item, i) => (
      <div class="reveal flex flex-col" style={`--i:${i}`}>
        <dt class="order-2 mt-2 max-w-[16rem] text-[0.9375rem] text-muted">{item.label}</dt>
        <dd class="order-1 text-[clamp(2.5rem,1.9rem+2vw,3.75rem)] leading-none font-medium tracking-[-0.04em] tabular">
          {item.value}
          {item.unit && <span class="ml-1 text-[0.45em] tracking-[-0.01em] text-muted">{item.unit}</span>}
        </dd>
      </div>
    ))
  }
</dl>
