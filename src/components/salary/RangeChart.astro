---
import { currencySymbol } from "@/lib/content";

interface Row {
  title: string;
  band: [number, number, number];
  change?: number;
  bonus?: string;
}

interface Props {
  rows: Row[];
  currency: string;
  caption: string;
  /** Shows the bonus column. */
  bonus?: boolean;
}

const { rows, currency, caption, bonus = false } = Astro.props;
const symbol = currencySymbol(currency);
const low = Math.min(...rows.map((row) => row.band[0]));
const high = Math.max(...rows.map((row) => row.band[2]));
const floor = Math.max(0, Math.floor((low * 0.85) / 10) * 10);
const ceil = Math.ceil((high * 1.05) / 10) * 10;
const at = (value: number) => ((value - floor) / (ceil - floor)) * 100;
const k = (value: number) => `${symbol}${value}k`;
---

<table class="range-chart w-full text-left tabular md:table-fixed">
  <caption class="sr-only">{caption}</caption>
  <thead class="text-[0.8125rem] text-muted">
    <tr class="border-b border-line">
      <th scope="col" class="py-2.5 pr-4 font-normal md:w-[32%]">Role</th>
      <th scope="col" class="hidden py-2.5 font-normal md:table-cell md:w-[38%]">
        <span class="sr-only">Range</span>
        <span class="flex justify-between" aria-hidden="true"><span>{k(floor)}</span><span>{k(ceil)}</span></span>
      </th>
      <th scope="col" class="py-2.5 pl-4 text-right font-normal md:w-[12%]">Median</th>
      {bonus && <th scope="col" class="hidden py-2.5 pl-4 text-right font-normal lg:table-cell lg:w-[16%]">Bonus</th>}
      <th scope="col" class="py-2.5 pl-4 text-right font-normal md:w-[10%]">YoY</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map((row) => (
        <tr class="border-b border-line">
          <th scope="row" class="py-3.5 pr-4 font-medium">
            {row.title}
            <span class="meta mt-0.5 block md:hidden">
              {k(row.band[0])} to {k(row.band[2])}
            </span>
          </th>
          <td class="hidden py-3.5 md:table-cell">
            <span class="relative block h-7" aria-label={`${k(row.band[0])} to ${k(row.band[2])}`}>
              <span class="absolute inset-x-0 top-1/2 h-1.5 -translate-y-1/2 rounded-full bg-wash" />
              <span class="range-bar absolute top-1/2 h-2.5 -translate-y-1/2 rounded-full bg-accent" style={`left:${at(row.band[0])}%;width:${at(row.band[2]) - at(row.band[0])}%`} />
              <span class="absolute top-1/2 size-3.5 -translate-x-1/2 -translate-y-1/2 rounded-full border-[3px] border-accent bg-surface" style={`left:${at(row.band[1])}%`} />
            </span>
          </td>
          <td class="py-3.5 pl-4 text-right text-sm font-medium">{k(row.band[1])}</td>
          {bonus && <td class="hidden py-3.5 pl-4 text-right text-sm text-muted lg:table-cell">{row.bonus}</td>}
          <td class:list={["py-3.5 pl-4 text-right text-sm font-medium", (row.change ?? 0) >= 0 ? "text-up" : "text-down"]}>
            {row.change !== undefined && `${row.change >= 0 ? "+" : ""}${row.change.toFixed(1)}%`}
          </td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .range-bar {
    transform-origin: left;
  }

  @supports (animation-timeline: view()) {
    .range-bar {
      animation: grow linear both;
      animation-timeline: view();
      animation-range: entry 10% entry 60%;
    }
  }

  @keyframes grow {
    from {
      clip-path: inset(0 100% 0 0);
    }
  }
</style>
