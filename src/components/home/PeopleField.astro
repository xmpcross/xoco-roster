---
import { Image } from "astro:assets";
import Figures from "@/components/ui/Figures.astro";
import { figures, market } from "@/config/home";
import { portraits } from "@/config/showcase";

const rows = 5;
const cols = 16;
/* A fixed scatter, so the build is stable: mostly small dots, a few large soft ones. */
const size = (i: number) => {
  const n = (i * 7919 + 13) % 37;
  if (n === 0 || n === 19) return "lg";
  if (n % 5 === 0) return "sm";
  return "md";
};
const cells = Array.from({ length: rows * cols }, (_, i) => size(i));
const start = [
  [2, 0], [14, 0], [6, 1], [15, 1], [1, 2], [10, 3], [4, 4], [12, 4], [8, 2],
];
---

<section class="section pt-8" aria-labelledby="market-title">
  <div class="shell">
    <div class="people-field relative" data-people-field style={`--rows:${rows}`} aria-hidden="true">
      <div class="field-grid grid">
        {cells.map((dot) => <span class="field-cell grid place-items-center"><span class:list={["dot", `dot-${dot}`]} /></span>)}
      </div>
      {
        portraits.map((person, i) => (
          <Image
            src={person.photo}
            alt=""
            width={144}
            height={144}
            class:list={["face", i >= start.length && "is-out"]}
            style={`--c:${start[i]?.[0] ?? 0};--r:${start[i]?.[1] ?? 0}`}
            loading="lazy"
          />
        ))
      }
    </div>

    <p id="market-title" class="reveal mx-auto mt-14 max-w-4xl text-center text-[clamp(1.4rem,1.1rem+1.1vw,2.1rem)] leading-[1.3] font-medium tracking-[-0.02em] text-balance">
      {market.strong} <span class="text-muted/70">{market.rest}</span>
    </p>

    <Figures items={figures} class="mt-20 lg:mt-24" />
  </div>
</section>

<style>
  .people-field {
    --cols: 7;
    overflow: hidden;
  }

  .field-grid {
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
  }

  .field-cell {
    aspect-ratio: 1;
  }

  /* Only columns x rows cells show; the rest wrap out of sight. */
  .field-cell:nth-child(n + 36) {
    display: none;
  }

  .dot {
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent-bright) 26%, var(--wash));
  }

  .dot-sm {
    width: 0.5rem;
    height: 0.5rem;
  }

  .dot-md {
    width: 1.15rem;
    height: 1.15rem;
  }

  .dot-lg {
    width: 3rem;
    height: 3rem;
    background: color-mix(in srgb, var(--accent-bright) 16%, var(--wash));
  }

  .face {
    position: absolute;
    left: calc((var(--c) + 0.5) * 100% / var(--cols));
    top: calc((var(--r) + 0.5) * 100% / var(--rows));
    width: clamp(2.75rem, 1.8rem + 2.6vw, 4rem);
    aspect-ratio: 1;
    border-radius: 999px;
    object-fit: cover;
    object-position: top;
    box-shadow:
      0 0 0 3px var(--paper),
      0 10px 24px -10px rgb(23 23 26 / 0.4);
    translate: -50% -50%;
    transition:
      scale 0.6s var(--ease-out-expo),
      opacity 0.4s;
  }

  .face.is-out {
    scale: 0.2;
    opacity: 0;
  }

  @media (width >= 48rem) {
    .people-field {
      --cols: 10;
    }

    .field-cell:nth-child(n + 36) {
      display: grid;
    }

    .field-cell:nth-child(n + 51) {
      display: none;
    }
  }

  @media (width >= 64rem) {
    .people-field {
      --cols: 16;
    }

    .field-cell:nth-child(n + 51) {
      display: grid;
    }
  }
</style>

<script>
  /* Portraits pop out and reappear on a free dot, a couple of seconds apart. */
  const field = document.querySelector<HTMLElement>("[data-people-field]");
  const still = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (field) {
    const faces = [...field.querySelectorAll<HTMLElement>(".face")];
    const rows = Number(getComputedStyle(field).getPropertyValue("--rows")) || 5;
    const cols = () => Number(getComputedStyle(field).getPropertyValue("--cols")) || 7;
    const spot = (face: HTMLElement) => [Number(face.style.getPropertyValue("--c")), Number(face.style.getPropertyValue("--r"))];
    const visible = () => faces.filter((face) => !face.classList.contains("is-out"));

    const freeCell = () => {
      const taken = visible().map(spot);
      const total = cols();
      for (let tries = 0; tries < 40; tries++) {
        const c = Math.floor(Math.random() * total);
        const r = Math.floor(Math.random() * rows);
        if (taken.every(([tc, tr]) => Math.abs(tc - c) + Math.abs(tr - r) > 2)) return [c, r];
      }
      return [Math.floor(Math.random() * total), Math.floor(Math.random() * rows)];
    };

    const place = (face: HTMLElement) => {
      const [c, r] = freeCell();
      face.style.setProperty("--c", String(c));
      face.style.setProperty("--r", String(r));
    };

    /* Keep a share of faces on screen that suits the column count. */
    const settle = () => {
      const want = Math.round(cols() * 0.55);
      faces.forEach((face) => face.classList.add("is-out"));
      faces.slice(0, want).forEach((face) => {
        place(face);
        face.classList.remove("is-out");
      });
    };

    const swap = () => {
      const shown = visible();
      const hidden = faces.filter((face) => face.classList.contains("is-out"));
      if (!shown.length || !hidden.length) return;
      shown[Math.floor(Math.random() * shown.length)].classList.add("is-out");
      const next = hidden[Math.floor(Math.random() * hidden.length)];
      place(next);
      window.setTimeout(() => next.classList.remove("is-out"), 350);
    };

    settle();
    let timer = 0;
    let lastCols = cols();
    const run = (on: boolean) => {
      window.clearInterval(timer);
      if (on && !still.matches) timer = window.setInterval(swap, 1800);
    };
    new IntersectionObserver(([entry]) => run(entry.isIntersecting)).observe(field);
    window.addEventListener("resize", () => {
      if (cols() === lastCols) return;
      lastCols = cols();
      settle();
    });
  }
</script>
